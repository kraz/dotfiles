{
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(git:*)",
      "Bash(php -l:*)",
      "Bash(chmod:*)",
      "Bash(composer show:*)",
      "Bash(php bin/console:*)",
      "Bash(php vendor/bin/phpunit:*)",
      "Bash(bin/phpunit:*)",
      "Bash(php:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "WebSearch",
      "Bash(php7.2 -l:*)",
      "Bash(php8.4-l:*)",
      "WebFetch(domain:www.elastic.co)",
      "WebFetch(domain:github.com)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "verbose": true,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "voiceEnabled": true
}
